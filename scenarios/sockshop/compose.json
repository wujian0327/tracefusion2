{
  "services": {
    "front-end": {
      "image": "weaveworksdemos/front-end:0.3.12",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "ports": [
        "127.0.0.1:${TF2_FRONT_PORT:-18080}:8079"
      ],
      "depends_on": [
        "user",
        "carts",
        "orders",
        "payment",
        "shipping"
      ]
    },
    "user": {
      "image": "weaveworksdemos/user:0.4.4",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "environment": {
        "MONGO_HOST": "user-db:27017",
        "HATEAOS": "user",
        "USER_DATABASE": "mongodb"
      },
      "depends_on": [
        "user-db"
      ]
    },
    "user-db": {
      "image": "weaveworksdemos/user-db:0.4.0",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "volumes": [
        "user-data:/data/db"
      ]
    },
    "carts": {
      "image": "weaveworksdemos/carts:0.4.8",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "environment": {
        "JAVA_OPTS": "-Xms64m -Xmx256m -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom -Dspring.zipkin.enabled=false"
      },
      "ports": [
        "127.0.0.1:${TF2_CART_PORT:-18081}:80"
      ],
      "depends_on": [
        "carts-db"
      ]
    },
    "carts-db": {
      "image": "mongo:3.4",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "volumes": [
        "carts-data:/data/db"
      ]
    },
    "orders": {
      "image": "weaveworksdemos/orders:0.4.7",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "environment": {
        "JAVA_OPTS": "-Xms64m -Xmx256m -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom -Dspring.zipkin.enabled=false"
      },
      "depends_on": [
        "orders-db"
      ]
    },
    "orders-db": {
      "image": "mongo:3.4",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "volumes": [
        "orders-data:/data/db"
      ]
    },
    "payment": {
      "image": "weaveworksdemos/payment:0.4.3",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      }
    },
    "shipping": {
      "image": "weaveworksdemos/shipping:0.4.8",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "environment": {
        "JAVA_OPTS": "-Xms64m -Xmx256m -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom -Dspring.zipkin.enabled=false"
      },
      "depends_on": [
        "rabbitmq"
      ]
    },
    "rabbitmq": {
      "image": "rabbitmq:3.6.8",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      }
    },
    "queue-master": {
      "image": "weaveworksdemos/queue-master:0.3.1",
      "platform": "linux/amd64",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "2"
        }
      },
      "environment": {
        "JAVA_OPTS": "-Xms64m -Xmx256m -XX:+UseG1GC -Djava.security.egd=file:/dev/urandom -Dspring.zipkin.enabled=false"
      },
      "depends_on": [
        "rabbitmq"
      ]
    }
  },
  "volumes": {
    "user-data": {},
    "carts-data": {},
    "orders-data": {}
  }
}
